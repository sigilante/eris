+# GENERATED by patches/nockchain/regen-standalone-ws.py — do not hand-edit.
+# Eris standalone workspace manifest for the nockvm subtree, lifted verbatim
+# from the pinned nockchain root Cargo.toml (see PROVENANCE.md). Isolates
+# nockvm from the nockchain monorepo workspace. Reconcile on pin bump by
+# re-running the generator; log dep drift in CHANGES.md.
+
+[workspace]
+resolver = "2"
+members = [
+    "rust/assert_no_alloc",
+    "rust/ibig",
+    "rust/nockvm",
+    "rust/nockvm_crypto",
+    "rust/nockvm_macros",
+    "rust/murmur3",
+    "rust/murmur3/murmur3-sys",
+]
+
+[workspace.package]
+version = "0.1.17"
+edition = "2021"
+
+[workspace.lints.rust]
+warnings = { level = "deny", priority = -1 }
+
+[workspace.lints.clippy]
+unwrap_used = "deny"
+missing_safety_doc = "allow"
+# Allowed for the nightly-2026-04-03 toolchain bump: the newer clippy newly flags these on
+# pre-existing code across the tree (nockapp, nockup, the verifier crates, ...). Deferred to a
+# dedicated cleanup pass; kept in sync with the `-A` clippy flags in `.bazelrc`.
+result_large_err = "allow"
+unnecessary_cast = "allow"
+unnecessary_sort_by = "allow"
+collapsible_match = "allow"
+manual_checked_ops = "allow"
+while_let_loop = "allow"
+# Style/complexity lints that are pervasive and idiomatic in the numeric / AIR /
+# STARK-prover code (explicit trace-index loops, prover functions with many
+# statement parameters, complex circuit-prover data types). Fixing them would hurt
+# clarity or force churny struct-wrapping without changing behaviour.
+needless_range_loop = "allow"
+too_many_arguments = "allow"
+type_complexity = "allow"
+# Pedantic style lints where the existing form is deliberate: mnemonic hex
+# constants (`0xC0FFEE_42`) and nested indented doc-list structure in the AIR
+# constraint documentation.
+unusual_byte_groupings = "allow"
+doc_overindented_list_items = "allow"
+doc_lazy_continuation = "allow"
+# Noun decoders dispatch on tag cords via `x if x == tas!(b"..")` guards (the
+# `tas!` macro cannot appear in pattern position), and some driver enums carry
+# one intentionally-large proof/artifact variant.
+redundant_guards = "allow"
+large_enum_variant = "allow"
+
+[workspace.dependencies]
+aes = { version = "0.8.3", default-features = false }
+aes-siv = { version = "0.7.0", default-features = false, features = ["alloc"] }
+bincode = "2.0.0-rc.3"
+bitvec = { version = "1.0.1", default-features = true }
+bytes = "1.5.0"
+cfg-if = "1.0.0"
+criterion = { git = "https://github.com/vlovich/criterion.rs.git", rev = "9b485aece85a3546126b06cc25d33e14aba829b3", features = ["html_reports"] }
+curve25519-dalek = { version = "4.1.1", default-features = false }
+ed25519-dalek = { version = "2.1.0", default-features = false }
+either = "1.9.0"
+ibig = { path = "rust/ibig" }
+intmap = "3.1.0"
+lazy_static = "1.4.0"
+libc = "0.2.171"
+memmap2 = "^0.9.5"
+murmur3 = { path = "rust/murmur3" }
+nockvm_crypto = { path = "rust/nockvm_crypto" }
+nockvm_macros = { path = "rust/nockvm_macros" }
+num-derive = "0.4.2"
+num-traits = { version = "0.2", default-features = true }
+proptest = "1.9.0"
+quote = "1.0.37"
+rand = { version = "0.9.2", default-features = true, features = ["std"] }
+serde = "1.0.217"
+sha1 = { version = "0.10.6", default-features = false }
+sha2 = { version = "0.10.8", default-features = false }
+slotmap = "1.0.7"
+smallvec = "1.15.1"
+static_assertions = "1.1.0"
+syn = { version = "2.0.39", features = ["full"] }
+tempfile = "3.3"
+thiserror = "2.0.11"
+tracing = "0.1.41"
+tracing-core = "0.1"
+x25519-dalek = { version = "2.0.0", features = ["static_secrets"], default-features = false }
